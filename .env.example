#AWS Configuration
AWS_ACCESS_KEY_ID = "your_AWS_ACCESS_KEY_ID"
AWS_ACCESS_SECRET_KEY_ID = "your_AWS_ACCESS_SECRET_KEY_ID"
AWS_REGION = "your_AWS_REGION"
S3_BUCKET = your_bucket_name

# Groq Configuration
GROQ_API_KEY = "your_api_key"
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Embedding Configuration
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384

#Pinecone Configuration
PINECONE_API_KEY = "your_PINECONE_API_KEY"
PINECONE_INDEX_HOST = "your_PINECONE_INDEX_HOST"
PINECONE_CLOUD = your_cloud
PINECONE_REGION = your_region
PINECONE_READY_TIMEOUT = 180

#Render-Postgres Configuration
DATABASE_URL = your_database_url

#RIUS Configuration
RIUS_API_KEY = "your_rius_api_key"
RIUS_SERVICE_NAME = your_rius_service_name
RIUS_DISABLED = false
RIUS_CAPTURE_CONTENT = false


